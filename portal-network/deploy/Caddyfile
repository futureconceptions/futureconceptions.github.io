# ------------------------------------------------------------------
# AUTOMATISCH ERZEUGT von `python3 portal-network/build.py --deploy-configs`
# Quelle: portal-network/sites/*/site.json – Änderungen bitte dort vornehmen.
# ------------------------------------------------------------------

{
	# TLS terminiert Cloudflare; der Tunnel spricht intern HTTP mit Caddy.
	auto_https off
	admin off
}

(static_site) {
	encode zstd gzip
	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "SAMEORIGIN"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
	@assets path /static/* /favicon.svg
	header @assets Cache-Control "public, max-age=2592000"
	@html path *.html */
	header @html Cache-Control "public, max-age=300, s-maxage=600"
	@feeds path /sitemap.xml /news-sitemap.xml /feed.xml /robots.txt /ads.txt /search-index.json
	header @feeds Cache-Control "public, max-age=300"
	file_server
	handle_errors {
		@404 expression {err.status_code} == 404
		handle @404 {
			rewrite * /404.html
			file_server
		}
	}
}

# Healthcheck für Uptime-Monitoring (z. B. Uptime Kuma): http://<pi>:8080/healthz
:8080 {
	respond /healthz "ok" 200
}

# agenturerfahrungen.de: deaktiviert (enabled: false in sites/agenturerfahrungen.de/site.json)

