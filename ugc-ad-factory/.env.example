# ----------------------------------------------------------------------------
# UGC Ad Factory configuration. Copy to .env and adjust.
# Secrets live ONLY here (or in your secret manager) - never in frontend code.
# ----------------------------------------------------------------------------

APP_ENV=development
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production-please-32+chars
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=admin12345
PUBLIC_API_URL=http://localhost:8080
CORS_ORIGINS=["http://localhost:8080","http://localhost:3000"]

# --- Providers --------------------------------------------------------------
# mock  = offline: real FFmpeg media, no paid calls (default, safe for evaluation)
# letzai = real generation (requires LETZAI_API_KEY; consumes credits)
MEDIA_PROVIDER=mock
LETZAI_API_KEY=
LETZAI_ORGANIZATION_ID=
LETZAI_IMAGE_MODEL=gemini-3-pro-image
LETZAI_EDIT_MODEL=gemini-3-pro-image
LETZAI_VIDEO_MODEL=video-seedance25
LETZAI_SPEECH_MODEL=audio-eleven-v4
LETZAI_VIDEO_RESOLUTION=720p
LETZAI_HAS_WATERMARK=false
LETZAI_MAX_CONCURRENT_JOBS=4
# Optional display conversion; credits remain the source of truth
LETZAI_USD_PER_CREDIT=
# Public HTTPS base URL LetzAI can call for webhooks (empty = polling only)
WEBHOOK_BASE_URL=

# heuristic = deterministic offline agents; anthropic = Claude (structured outputs + vision QA)
LLM_PROVIDER=heuristic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_FALLBACK_MODEL=claude-opus-4-8

# Lip-sync for TTS scenes (LetzAI has no lip-sync endpoint): none | wavespeed | mock
LIPSYNC_PROVIDER=none
WAVESPEED_API_KEY=

# Dialogue verification (optional, needs `pip install faster-whisper` in the image): none | faster_whisper
TRANSCRIPTION_PROVIDER=none

# --- Limits & pipeline --------------------------------------------------------
DEFAULT_PROJECT_BUDGET_CREDITS=20000
GLOBAL_BUDGET_CREDITS=500000
DEFAULT_VIDEO_CANDIDATES=1
MAX_JOB_ATTEMPTS=3
MAX_QA_ROUNDS=2
QA_IDENTITY_MIN_SCORE=0.80
POLL_INTERVAL_SECONDS=5
POLL_TIMEOUT_SECONDS=1800
DATA_RETENTION_DAYS=90

# --- Infrastructure (docker compose) ------------------------------------------
POSTGRES_PASSWORD=ugc
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
# URL browsers use for presigned media links
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=ugc-assets
HTTP_PORT=8080
WORKER_CONCURRENCY=4
